\frametitle{Registracija routera i Pinie u main.ts}
\begin{lstlisting}[language=typescript]
// src/main.ts
import { createApp } from 'vue'
import { createPinia } from 'pinia'
import App from './App.vue'
import router from './router'

const app = createApp(App)
app.use(createPinia())
app.use(router)
app.mount('#app')
\end{lstlisting}

\vspace{0.4em}
\texttt{app.use()} registrira plugine. Redoslijed je bitan - Pinia prije routera jer route guardovi mogu koristiti storeove.
