\frametitle{Pokretanje projekta lokalno}
\begin{lstlisting}[language=bash]
# 1) Baza (Postgres)
docker compose up -d db

# 2) Backend
cd api
uv venv
source .venv/bin/activate
uv pip install -r requirements.txt
alembic upgrade head
python -m app.seed
uvicorn app.main:app --reload

# 3) Frontend
cd ../web
npm install
npm run dev
\end{lstlisting}
